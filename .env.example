# Riot Games API key (https://developer.riotgames.com). Leave empty to run NEXUS in demo mode.
# Never prefix it with NEXT_PUBLIC_ — it must stay on the server.
RIOT_API_KEY=

# Optional PostgreSQL connection. Enables the persistent cache, LP snapshots and
# the aggregated champion dataset (tier list, builds). Without it NEXUS uses memory cache.
DATABASE_URL=

# Default platform shown on first launch (euw1, eun1, na1, kr, ...)
NEXUS_DEFAULT_PLATFORM=euw1

# --- Production server (deploy/install.sh fills these in for you) ---
# Never show demo data; without a key the app says "no API key yet".
NEXUS_DISABLE_DEMO=
# Password for /admin, where the Riot key can be pasted/rotated from a phone.
ADMIN_PASSWORD=
# Where the key saved from /admin is stored (default: ./.nexus-data).
NEXUS_DATA_DIR=

# --- Desktop build only ---
# Address of your NEXUS server baked into the .exe (e.g. https://1-2-3-4.sslip.io).
# Empty = the app runs its own local server and reads RIOT_API_KEY from %APPDATA%/NEXUS/.env.
NEXUS_SERVER_URL=
